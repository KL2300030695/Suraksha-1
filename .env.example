# ============================================================
# Suraksha serverless email (Brevo) — server-only secrets.
# Set these as Environment Variables in your Vercel project
# (Settings -> Environment Variables). NEVER commit real values.
# The /api functions read these; the frontend never sees them.
# ============================================================

# Brevo transactional email API key (starts with "xkeysib-").
BREVO_API_KEY="your-brevo-api-key"

# A sender address you have VERIFIED in Brevo (Senders & IPs).
BREVO_SENDER_EMAIL="verified-sender@example.com"
BREVO_SENDER_NAME="Suraksha Campus Network"

# Firebase Admin service account, as a single-line JSON string.
# Firebase console -> Project settings -> Service accounts -> Generate new private key,
# then paste the entire JSON file contents as the value of this variable.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}'

# ============================================================
# Live donor tracking — routing (OPTIONAL, client-side, VITE_ prefix).
# Defaults work with no config: the public OSRM demo server (no key) is used
# for routes and OpenStreetMap Nominatim for geocoding.
# ============================================================

# Override the OSRM routing base URL (e.g. a self-hosted OSRM instance).
# VITE_OSRM_URL="https://router.project-osrm.org"

# Optional OpenRouteService API key. If set, ORS is used for routing instead of
# the public OSRM demo server (better rate limits). Get one free at openrouteservice.org.
# VITE_ORS_API_KEY="your-openrouteservice-api-key"
